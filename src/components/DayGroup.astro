---
import { formatDate, parseDayKey } from '../utils/dates';
import { normalizeTags } from '../utils/tags';
import { isHtmlEntry, type StreamEntry } from '../utils/htmlPosts';
import EntryCard from './EntryCard.astro';
import HtmlPostCard from './HtmlPostCard.astro';
import QuoteCard from './QuoteCard.astro';
import NoteCard from './NoteCard.astro';
import LinkCard from './LinkCard.astro';
import ReleaseCard from './ReleaseCard.astro';

interface Props {
  /** 上海时区日键 YYYY-MM-DD（groupPostsByDay 的分组键） */
  dayKey: string;
  posts: StreamEntry[];
  startIndex?: number;
}

const { dayKey, posts, startIndex = 0 } = Astro.props;

const date = parseDayKey(dayKey);
const weekday = formatDate(date, { weekday: 'long' });
const dateLabel = formatDate(date, { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="day-group" data-date={dayKey}>
  <h2 class="day-heading">
    <time datetime={dayKey}>
      {dateLabel}
      <span class="day-weekday">{weekday}</span>
    </time>
  </h2>

  <div class="day-entries">
    {posts.map((post, i) => {
      if (isHtmlEntry(post)) {
        return (
          <HtmlPostCard
            id={post.id}
            title={post.data.title}
            date={post.data.date}
            excerpt={post.data.excerpt}
            tags={normalizeTags(post.data.tags)}
            index={startIndex + i}
          />
        );
      }
      const commonProps = {
        id: post.id,
        date: post.data.date,
        tags: normalizeTags(post.data.tags),
        index: startIndex + i,
      };
      if (post.data.type === 'quote') {
        return (
          <QuoteCard
            {...commonProps}
            body={post.body}
            author={post.data.author}
            title={post.data.title}
            linkUrl={post.data.linkUrl}
            context={post.data.context}
          />
        );
      }
      if (post.data.type === 'note') {
        return <NoteCard {...commonProps} body={post.body} />;
      }
      if (post.data.type === 'link') {
        return (
          <LinkCard
            {...commonProps}
            title={post.data.title}
            linkUrl={post.data.linkUrl}
            body={post.body}
          />
        );
      }
      if (post.data.type === 'release') {
        return (
          <ReleaseCard
            {...commonProps}
            title={post.data.title}
            linkUrl={post.data.linkUrl}
            body={post.body}
          />
        );
      }
      return (
        <EntryCard
          id={post.id}
          title={post.data.title || post.id}
          date={post.data.date}
          excerpt={post.data.excerpt}
          body={post.body}
          tags={normalizeTags(post.data.tags)}
          image={post.data.image}
          index={startIndex + i}
        />
      );
    })}
  </div>
</section>
