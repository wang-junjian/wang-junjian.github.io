---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getShanghaiDateComponents } from '../../utils/posts';
import { getMergedPosts } from '../../utils/mergedPosts';
import { getStreamPageData } from '../../utils/streamPage';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import StreamTabs from '../../components/StreamTabs.astro';
import StreamSearchBar from '../../components/StreamSearchBar.astro';
import StreamContent from '../../components/StreamContent.astro';

export async function getStaticPaths() {
  const posts = await getMergedPosts();
  const monthKeys = new Set<string>();
  for (const post of posts) {
    if (!post.data.date) continue;
    const { year, month } = getShanghaiDateComponents(post.data.date);
    monthKeys.add(`${year}/${String(month).padStart(2, '0')}`);
  }

  return Array.from(monthKeys).map((key) => {
    const [year, month] = key.split('/');
    return { params: { year, month } };
  });
}

const { year, month } = Astro.params;
const yearNum = parseInt(year, 10);
const monthNum = parseInt(month, 10);

const posts = await getMergedPosts();
const monthPosts = posts.filter((post) => {
  if (!post.data.date) return false;
  const { year, month } = getShanghaiDateComponents(post.data.date);
  return year === yearNum && month === monthNum;
});

// 月归档不分页：当月文章全列出
const { sortedPosts, dayGroups, sortedDays, pageNeedsKatex } =
  getStreamPageData(monthPosts, { paginate: false });

const monthTitle = `${yearNum} 年 ${monthNum} 月`;
const totalPosts = sortedPosts.length;
---

<BaseLayout
  title={`${monthTitle} - ${SITE_TITLE}`}
  description={`${SITE_TITLE} ${monthTitle} 的所有文章。${SITE_DESCRIPTION}`}
  canonical={Astro.url.toString()}
  showChat={false}
  needsKatex={pageNeedsKatex}
>
  <link rel="stylesheet" href="/styles/prose.css" />
  <section class="pt-10 pb-6 px-8">
    <div class="max-w-grid mx-auto">
      <div class="flex-1 min-w-0">
        <StreamTabs currentType="all" />
        <StreamSearchBar placeholder={`在 ${monthTitle} 中搜索...`} />

        <StreamContent
          dayGroups={dayGroups}
          sortedDays={sortedDays}
          totalPosts={totalPosts}
          year={yearNum}
          month={monthNum}
        />

      </div>
    </div>
  </section>

  <script>
    import { enhancePostContent } from '../../scripts/post-scripts';
    import { initSearch } from '../../scripts/search';

    function init() {
      enhancePostContent();
      initSearch();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('turbo:load', init);
  </script>
</BaseLayout>
