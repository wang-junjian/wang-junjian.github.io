---
import { formatTime } from '../utils/dates';
import { renderCardExcerpt } from '../utils/preview';
import { normalizeTags } from '../utils/tags';
import { getPostUrl } from '../utils/entryUrls';
import { CONTENT_TYPE_MAP, getTypeUrl } from '../utils/contentTypes';
const contentType = CONTENT_TYPE_MAP['note'];

interface Props {
  id: string;
  body?: string;
  date: Date;
  tags?: string[] | string | null;
  showDate?: boolean;
  index?: number;
}

const {
  id,
  body,
  date,
  tags,
  showDate = true,
  index = 0,
} = Astro.props;

const noteHtml = body ? renderCardExcerpt(body) : '';

const href = getPostUrl(id);

const tagList = normalizeTags(tags);
---

<article
  class="post-item note-card"
  style={`animation-delay: ${((index % 6) * 0.1).toFixed(1)}s;`}
  data-id={id}
>
  <a href={getTypeUrl(contentType.type)} class="type-badge type-badge-note">{contentType.label}</a>

  <div class="note-text card-body" set:html={noteHtml} />

  <div class="entry-meta">
    {showDate && (
      <a href={href} class="post-time-link">
        <time datetime={date.toISOString()}>
          {formatTime(date)}
        </time>
      </a>
    )}

    {tagList.length > 0 && (
      <>
        <span class="meta-separator" aria-hidden="true">·</span>
        <div class="entry-tags">
          {tagList.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`} class="entry-tag">{tag}</a>
          ))}
        </div>
      </>
    )}
  </div>
</article>
