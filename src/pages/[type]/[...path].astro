---
import TypePage from '../../components/TypePage.astro';
import { getMergedPosts } from '../../utils/mergedPosts';
import { parsePageParam } from '../../utils/pagination';
import { CONTENT_TYPES, CONTENT_TYPE_MAP, getTypeUrl } from '../../utils/contentTypes';
import {
  getTypePageData,
  getTypeSidebarData,
  getTypeStaticPaths,
} from '../../utils/typePages';

export async function getStaticPaths() {
  const allPosts = await getMergedPosts();
  const paths: Array<{
    params: { type: string; path?: string };
    props: { type: string; baseUrl: string };
  }> = [];

  for (const ct of CONTENT_TYPES) {
    const typePaths = getTypeStaticPaths(allPosts, ct.type);
    for (const p of typePaths) {
      paths.push({
        params: { type: ct.alias, path: p.params.path },
        props: { type: ct.type, baseUrl: getTypeUrl(ct.type) },
      });
    }
  }

  return paths;
}

const { type, baseUrl } = Astro.props;
const { path } = Astro.params;
const config = CONTENT_TYPE_MAP[type];

if (!config) {
  return Astro.redirect('/404/');
}

const allPosts = await getMergedPosts();
const page = parsePageParam(path);
const { typePosts, pageResult, dayGroups, sortedDays, pageNeedsKatex } = getTypePageData(allPosts, type, page);
const { recentContent, recentTags } = getTypeSidebarData(typePosts);
---

<TypePage
  title={config.label}
  description={config.description}
  pageTitle={config.label}
  countLabel={config.countLabel(typePosts.length)}
  emptyMessage={config.emptyMessage}
  type={config.type}
  dayGroups={dayGroups}
  sortedDays={sortedDays}
  currentPage={pageResult.currentPage}
  totalPages={pageResult.totalPages}
  baseUrl={baseUrl}
  recentContent={recentContent}
  recentTags={recentTags}
  totalPosts={typePosts.length}
  needsKatex={pageNeedsKatex}
/>
