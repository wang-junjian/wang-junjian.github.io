---
import { formatTime } from '../utils/dates';
import { getHtmlPostUrl } from '../utils/entryUrls';

interface Props {
  id: string;
  title: string;
  date: Date;
  excerpt?: string;
  tags?: string[];
  showDate?: boolean;
  index?: number;
}

const {
  id,
  title,
  date,
  excerpt,
  tags = [],
  showDate = true,
  index = 0,
} = Astro.props;

// HTML 文章是独立自包含页面，必须绕过 Turbo（data-turbo="false"），
// 否则 Turbo 会把完整 HTML 文档塞进博客布局外壳。
const href = getHtmlPostUrl(id);
const searchExcerpt = (excerpt || '').toLowerCase();
---

<article
  class="post-item entry-card html-post-card"
  style={`animation-delay: ${((index % 6) * 0.1).toFixed(1)}s;`}
  data-title={title.toLowerCase()}
  data-excerpt={searchExcerpt}
  data-id={id}
>
  <h3 class="entry-title">
    <a href={href} data-turbo="false">{title}<span class="html-post-badge">HTML</span></a>
  </h3>

  {excerpt && (
    <div class="entry-excerpt">
      <p>{excerpt}</p>
    </div>
  )}

  <div class="entry-meta">
    {showDate && (
      <a href={href} data-turbo="false" class="post-time-link">
        <time datetime={date.toISOString()}>
          {formatTime(date)}
        </time>
      </a>
    )}

    {tags.length > 0 && (
      <>
        <span class="meta-separator" aria-hidden="true">·</span>
        <div class="entry-tags">
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`} class="entry-tag">{tag}</a>
          ))}
        </div>
      </>
    )}
  </div>
</article>

<style>
  .html-post-badge {
    display: inline-block;
    margin-left: 0.5em;
    padding: 0.1em 0.45em;
    font-size: 0.55em;
    font-weight: 600;
    letter-spacing: 0.05em;
    vertical-align: middle;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
  }
</style>
