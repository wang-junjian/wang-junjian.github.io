---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTags, getPostDisplayTitle } from '../utils/posts';
import { getEntryUrl } from '../utils/htmlPosts';
import { getMergedPosts } from '../utils/mergedPosts';
import { PAGE_SIZE, parsePageParam, getPagePaths } from '../utils/pagination';
import { getStreamPageData } from '../utils/streamPage';
import { getTools } from '../utils/tools';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import StreamSidebar from '../components/StreamSidebar.astro';
import StreamTabs from '../components/StreamTabs.astro';
import StreamSearchBar from '../components/StreamSearchBar.astro';
import StreamContent from '../components/StreamContent.astro';
import Pagination from '../components/Pagination.astro';

export async function getStaticPaths() {
  const allPosts = await getMergedPosts();
  const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
  return getPagePaths(totalPages).map((path) => ({ params: { path } }));
}

const allPosts = await getMergedPosts();
const page = parsePageParam(Astro.params.path);

const { sortedPosts, pageResult, dayGroups, sortedDays, pageNeedsKatex } =
  getStreamPageData(allPosts, { page });

// Prepare sidebar data: top tags by count
const allTags = getAllTags(allPosts);
const recentTags = Array.from(allTags.entries())
  .map(([tag, posts]) => [tag, posts.length] as [string, number])
  .sort((a, b) => b[1] - a[1])
  .slice(0, 20);

// Recent content: chronological list for the sidebar (10 items)
const recentContent = sortedPosts.slice(0, 10).map((post) => ({
  id: post.id,
  title: getPostDisplayTitle(post),
  date: post.data.date,
  url: getEntryUrl(post),
}));

// Random content: shuffled list for the sidebar (6 items)
const randomContent = [...sortedPosts]
  .sort(() => Math.random() - 0.5)
  .slice(0, 6)
  .map((post) => ({
    id: post.id,
    title: getPostDisplayTitle(post),
    date: post.data.date,
    url: getEntryUrl(post),
  }));

// Random tools for homepage sidebar
const randomTools = getTools()
  .sort(() => Math.random() - 0.5)
  .slice(0, 2);

const pageTitle = page > 1 ? `${SITE_TITLE} - 第 ${page} 页` : `${SITE_TITLE} - ${SITE_DESCRIPTION}`;
---

<BaseLayout
  title={pageTitle}
  description={SITE_DESCRIPTION}
  canonical={Astro.url.toString()}
  showChat={false}
  needsKatex={pageNeedsKatex}
>
  <link rel="stylesheet" href="/styles/prose.css" />
  <!-- Stream + Sidebar -->
  <section class="pt-10 pb-6 px-8">
    <div class="max-w-grid mx-auto">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
        <!-- Main Stream -->
        <div class="flex-1 min-w-0">
          <StreamTabs currentType="all" />
          <StreamSearchBar placeholder="搜索本站..." />

          <StreamContent
            dayGroups={dayGroups}
            sortedDays={sortedDays}
            totalPosts={allPosts.length}
          />

          <Pagination
            currentPage={pageResult.currentPage}
            totalPages={pageResult.totalPages}
            baseUrl="/"
          />
        </div>

        <!-- Sidebar -->
        <StreamSidebar totalPosts={allPosts.length} recentTags={recentTags} recentContent={recentContent} randomContent={randomContent} randomTools={randomTools} />
      </div>
    </div>
  </section>

  <script>
    import { enhancePostContent } from '../scripts/post-scripts';
    import { initSearch } from '../scripts/search';

    function init() {
      enhancePostContent();
      initSearch();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('turbo:load', init);
  </script>
</BaseLayout>
