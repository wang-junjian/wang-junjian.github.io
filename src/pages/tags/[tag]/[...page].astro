---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMergedPosts } from '../../../utils/htmlPosts';
import { getTagStaticPaths, getTagPageData } from '../../../utils/tagPages';
import { parsePageParam } from '../../../utils/pagination';
import { SITE_TITLE } from '../../../consts';
import TagPageHeader from '../../../components/TagPageHeader.astro';
import StreamContent from '../../../components/StreamContent.astro';
import Pagination from '../../../components/Pagination.astro';
import TagSidebar from '../../../components/TagSidebar.astro';

export async function getStaticPaths() {
  const posts = await getMergedPosts();
  return getTagStaticPaths(posts);
}

const { tag, posts, allTagCounts } = Astro.props;
const page = parsePageParam(Astro.params.page);
const tagUrl = `/tags/${encodeURIComponent(tag)}`;

const {
  pageResult,
  dayGroups,
  sortedDays,
  recentTags,
  pageNeedsKatex,
} = getTagPageData(tag, posts, allTagCounts, page);

const title = page > 1
  ? `${tag} - 第 ${page} 页 - 标签 - ${SITE_TITLE}`
  : `${tag} - 标签 - ${SITE_TITLE}`;
const description = page > 1
  ? `浏览标签 "${tag}" 下的文章 - 第 ${page} 页。`
  : `浏览标签 "${tag}" 下的文章。`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={Astro.url.toString()}
  showChat={false}
  needsKatex={pageNeedsKatex}
>
  <TagPageHeader tag={tag} postCount={posts.length} />

  <link rel="stylesheet" href="/styles/prose.css" />

  <section class="pt-4 pb-6 px-8">
    <div class="max-w-grid mx-auto">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
        <!-- Main Stream -->
        <div class="flex-1 min-w-0">
          <StreamContent
            dayGroups={dayGroups}
            sortedDays={sortedDays}
            totalPosts={posts.length}
          />

          <Pagination
            currentPage={pageResult.currentPage}
            totalPages={pageResult.totalPages}
            baseUrl={tagUrl}
          />
        </div>

        <!-- Sidebar -->
        <TagSidebar recentTags={recentTags} />
      </div>
    </div>
  </section>
  <script>
    import { enhancePostContent } from '../../../scripts/post-scripts';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhancePostContent);
    } else {
      enhancePostContent();
    }
    document.addEventListener('turbo:load', enhancePostContent);
  </script>
</BaseLayout>
